    </div>
    <div class="col-6">
        <div class="row">
            <div class="col-11">
                <h3>Others' Source Sets</h3>
            </div>
        </div>
        <div class="tableFixHead">
            <table class="table table-striped align-middle">
                <caption hidden>Others' Source Sets</caption>
                <thead class="table-dark">
                    <tr>
                        @foreach (var header in Model.SourceHeaders)
                        {
                            <th>
                                <div class="d-flex justify-content-center">@header</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.SourceSets.Where(item => !item.UserName!.Equals(User.Identity?.Name)))
                    {
                        <tr>
                            <form class="form" method="post">
                            <td>
                                <div class="d-flex justify-content-center">@item.Name</div>
                            </td>
                            <td>
                                <div class="d-flex justify-content-center">@item.UploadedDate</div>
                            </td>
                            <td>
