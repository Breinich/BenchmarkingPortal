                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Executables.Where(item => !item.UserName.Equals(User.Identity?.Name)))
                    {
                        <tr>
                            <form class="form" method="post">
                            <td>
                                <div class="d-flex justify-content-center">@item.Name</div>
                            </td>
                            <td>
                                <div class="d-flex justify-content-center">@item.OwnerTool</div>
                            </td>
                            <td>
                                <div class="d-flex justify-content-center">@item.UploadedDate</div>
                            </td>
                            <td>
                                <div class="d-flex justify-content-center">
                                    <button type="submit" class="btn btn-primary m-1" asp-page-handler="Download" asp-route-fileId="@item.Path">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-download" viewBox="0 0 16 16">
                                            <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" />
                                            <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                            </form>
                        </tr>
